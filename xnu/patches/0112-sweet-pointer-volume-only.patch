diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 3e15609..8e0b925 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -197,59 +197,61 @@ sweet_pointer_swipe_up(void)
 static uint64_t sweet_pointer_pressed_at;
 
 /*
- * A button changed state.  The power key acts on its release: a short press taps
- * where the cursor is, a hold swipes up from there (which is how the hello screen
- * is dismissed and how iOS goes home).
+ * The buttons, with the power key left alone: it locks and wakes the display,
+ * and taking it over for a cursor would cost that.  Everything the pointer does
+ * is on the volume key that reaches this driver (the volume-down one, on the
+ * PMIC's PON block; the other reads 0 through a GPIO expander that the touch
+ * bring-up is what configures), told apart by how long it is held:
+ *
+ *   shorter than 0.4 s       move the cursor on (right, then down a row)
+ *   0.4 s to 1.5 s           tap where it is
+ *   longer than 1.5 s        swipe upward from where it is ("Swipe up to open")
  */
+#define SWEET_POINTER_TAP_AFTER_US      400000
+#define SWEET_POINTER_SWIPE_AFTER_US    1500000
+
 void
 sweet_pointer_key(int key, int down)
 {
-	if (key == 0) {
+	if (key == 2) {
 		if (down) {
 			sweet_pointer_pressed_at = sweet_pointer_now_us();
 			return;
 		}
-		if (sweet_pointer_now_us() - sweet_pointer_pressed_at >= SWEET_POINTER_HOLD_US) {
+		uint64_t held = sweet_pointer_now_us() - sweet_pointer_pressed_at;
+
+		if (held >= SWEET_POINTER_SWIPE_AFTER_US) {
 			sweet_pointer_swipe_up();
-		} else {
+		} else if (held >= SWEET_POINTER_TAP_AFTER_US) {
 			sweet_hid_touch(0, 1, sweet_pointer_x, sweet_pointer_y);
 			delay(SWEET_POINTER_TAP_US);
 			sweet_hid_touch(0, 0, sweet_pointer_x, sweet_pointer_y);
-			printf("SWEET POINTER: tap at %d,%d\n", sweet_pointer_x, sweet_pointer_y);
+			printf("SWEET POINTER: tap at %d,%d (held %llu ms)\n",
+			    sweet_pointer_x, sweet_pointer_y, held / 1000);
+		} else {
+			sweet_pointer_x += SWEET_POINTER_STEP;
+			if (sweet_pointer_x > SWEET_POINTER_MAX_X) {
+				sweet_pointer_x = 0;
+				sweet_pointer_y += SWEET_POINTER_STEP;
+				if (sweet_pointer_y > SWEET_POINTER_MAX_Y) {
+					sweet_pointer_y = 0;
+				}
+			}
+			printf("SWEET POINTER: move to %d,%d\n", sweet_pointer_x, sweet_pointer_y);
 		}
 		return;
 	}
 	if (!down) {
 		return;
 	}
-	/*
-	 * Only one of the two volume keys reaches this driver so far (the one on the
-	 * PMIC's PON block; the other reads 0 through the GPIO expander), so the key
-	 * that works walks the cursor like a text cursor - right, then down a row
-	 * when it runs off the edge - and one button plus the power key reaches
-	 * everything.  The other, if it starts reporting, goes up a row.
-	 */
-	switch (key) {
-	case 1:
+	/* The other volume key, if it ever starts reporting: a row up. */
+	if (key == 1) {
 		sweet_pointer_y -= SWEET_POINTER_STEP;
 		if (sweet_pointer_y < 0) {
 			sweet_pointer_y = SWEET_POINTER_MAX_Y;
 		}
-		break;
-	case 2:
-		sweet_pointer_x += SWEET_POINTER_STEP;
-		if (sweet_pointer_x > SWEET_POINTER_MAX_X) {
-			sweet_pointer_x = 0;
-			sweet_pointer_y += SWEET_POINTER_STEP;
-			if (sweet_pointer_y > SWEET_POINTER_MAX_Y) {
-				sweet_pointer_y = 0;
-			}
-		}
-		break;
-	default:
-		break;
+		printf("SWEET POINTER: key 1, now %d,%d\n", sweet_pointer_x, sweet_pointer_y);
 	}
-	printf("SWEET POINTER: key %d, now %d,%d\n", key, sweet_pointer_x, sweet_pointer_y);
 }
 
 void
