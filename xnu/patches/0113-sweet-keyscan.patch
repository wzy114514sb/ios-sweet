+/*
+ * SWEET: every button on the phone works in Android and this driver sees only
+ * the two on the PMIC's PON block; the volume up key and the AI key are not
+ * among them, and the GPIO expander registers read here return 0.  With boot-arg
+ * sweetkeyscan=1 the expander's register window is scanned once a second and only
+ * the bytes that change are printed, so pressing those keys says which registers,
+ * and which bits, they appear in.
+ */
+#define SWEET_KEYSCAN_FIRST     0xc000u
+#define SWEET_KEYSCAN_LAST      0xcfffu
+#define SWEET_KEYSCAN_SIZE      (SWEET_KEYSCAN_LAST - SWEET_KEYSCAN_FIRST + 1)
+
+static uint8_t sweet_keyscan_shadow[SWEET_KEYSCAN_SIZE];
+static bool    sweet_keyscan_ready;
+static bool    sweet_keyscan_enabled;
+
+static void
+sweet_keyscan(void)
+{
+	unsigned changed = 0;
+
+	for (uint32_t addr = SWEET_KEYSCAN_FIRST; addr <= SWEET_KEYSCAN_LAST; addr++) {
+		uint8_t value = 0;
+		uint32_t off;
+
+		if (!keys_read(keys_gpio_apid, addr, &value)) {
+			continue;
+		}
+		off = addr - SWEET_KEYSCAN_FIRST;
+		if (sweet_keyscan_ready && value != sweet_keyscan_shadow[off] && changed < 12) {
+			printf("SWEET KEYSCAN: %#x: %#x -> %#x\n", addr,
+			    sweet_keyscan_shadow[off], value);
+			changed++;
+		}
+		sweet_keyscan_shadow[off] = value;
+	}
+	sweet_keyscan_ready = true;
+}
