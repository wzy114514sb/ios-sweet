+/* Called once per pass of the key thread, before the changes are handled. */
+void
+sweet_pointer_tick(int volume_down)
+{
+	if (volume_down && sweet_pointer_ticks < 0xffff) {
+		sweet_pointer_ticks++;
+	}
+}
