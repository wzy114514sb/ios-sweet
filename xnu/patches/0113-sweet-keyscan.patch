diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 8e0b925..b6a35a4 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -94,6 +94,45 @@ keys_wait(void)
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * SWEET: pressing every button on the phone in Android tells us that the volume
+ * up key and the AI key work, and this driver sees neither: they are not on the
+ * PMIC's PON block, and the GPIO expander registers read here return 0.  With
+ * boot-arg sweetkeyscan=1 a scan of the expander's register window is kept and
+ * only the bytes that change are printed, so pressing those two keys says which
+ * registers (and which bits) they really appear in.
+ */
+#define SWEET_KEYSCAN_FIRST     0xc000u
+#define SWEET_KEYSCAN_LAST      0xcfffu
+#define SWEET_KEYSCAN_SIZE      (SWEET_KEYSCAN_LAST - SWEET_KEYSCAN_FIRST + 1)
+
+static uint8_t sweet_keyscan_shadow[SWEET_KEYSCAN_SIZE];
+static bool    sweet_keyscan_enabled;
+static bool    sweet_keyscan_ready;
+
+static void
+sweet_keyscan(void)
+{
+	unsigned changed = 0;
+
+	for (uint32_t addr = SWEET_KEYSCAN_FIRST; addr <= SWEET_KEYSCAN_LAST; addr++) {
+		uint8_t value = 0;
+
+		if (!keys_read(keys_gpio_apid, addr, &value)) {
+			continue;
+		}
+		uint32_t off = addr - SWEET_KEYSCAN_FIRST;
+
+		if (sweet_keyscan_ready && value != sweet_keyscan_shadow[off] && changed < 12) {
+			printf("SWEET KEYSCAN: %#x: %#x -> %#x\n", addr,
+			    sweet_keyscan_shadow[off], value);
+			changed++;
+		}
+		sweet_keyscan_shadow[off] = value;
+	}
+	sweet_keyscan_ready = true;
+}
+
 static void
 keys_thread(void *arg, wait_result_t result)
 {
@@ -114,6 +153,9 @@ keys_thread(void *arg, wait_result_t result)
 		} else {
 			errors = 0;
 		}
+		if (sweet_keyscan_enabled) {
+			sweet_keyscan();
+		}
 		for (int k = 0; k < 3; ++k) {
 			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
 				state[k] = now[k];
@@ -258,7 +300,12 @@ void
 sweet_keys_init(void)
 {
 	int enabled = 1;
+	int scan = 0;
 	thread_t thread;
+	if (PE_parse_boot_argn("sweetkeyscan", &scan, sizeof(scan)) && scan != 0) {
+		sweet_keyscan_enabled = true;
+		printf("SWEET KEYSCAN: watching %#x..%#x\n", SWEET_KEYSCAN_FIRST, SWEET_KEYSCAN_LAST);
+	}
 	if (keys_started) {
 		return;
 	}
