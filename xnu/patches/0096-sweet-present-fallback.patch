+/*
+ * SWEET: the two queries the display uses when the surface it is told to show
+ * turns out to be empty (see AppleCLCD::present); sampling only.
+ */
+bool
+sweet_surface_has_content(SweetSurface *s)
+{
+	uintptr_t base;
+	uint32_t bpr;
+
+	if (s == NULL) {
+		return false;
+	}
+	base = s->kernelAddress();
+	bpr = s->bytesPerRow;
+	if (base == 0 || bpr == 0 || s->height == 0 || s->width < 4) {
+		return false;
+	}
+	for (uint32_t y = 0; y < s->height; y += 64) {
+		const uint32_t *row = (const uint32_t *)(base + (uint64_t)y * bpr);
+		for (uint32_t x = 0; x < s->width; x += 64) {
+			if ((row[x] & 0x00ffffff) != 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+SweetSurface *
+sweet_surface_any_with_content(uint32_t except)
+{
+	SweetSurface *candidates[8];
+	SweetSurface *found = NULL;
+	uint32_t n = 0;
+
+	if (sweet_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	for (uint32_t i = 1; i < SWEET_SURFACE_MAX_ID && n < 8; i++) {
+		SweetSurface *s = sweet_surface_table[i];
+		if (s == NULL || s->id == except) {
+			continue;
+		}
+		s->retain();
+		candidates[n++] = s;
+	}
+	IOLockUnlock(sweet_surface_lock);
+
+	for (uint32_t i = 0; i < n; i++) {
+		if (found == NULL && sweet_surface_has_content(candidates[i])) {
+			found = candidates[i];
+		} else {
+			candidates[i]->release();
+		}
+	}
+	return found;
+}
