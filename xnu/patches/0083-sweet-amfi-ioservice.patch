diff --git a/iokit/Kernel/arm/SweetAMFI.cpp b/iokit/Kernel/arm/SweetAMFI.cpp
new file mode 100644
index 0000000..050535c
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAMFI.cpp
@@ -0,0 +1,104 @@
+/*
+ * Built-in AMFI IOService for SWEET.
+ *
+ * Apple's AMFI kext publishes an IOService named AppleMobileFileIntegrity and
+ * iOS userland talks to it through a user client.  launchd_cache_loader, one
+ * of launchd's early boot tasks, is the first one to need it:
+ *
+ *   service = IOServiceGetMatchingService(kIOMasterPortDefault,
+ *                 IOServiceMatching("AppleMobileFileIntegrity"));
+ *   IOServiceOpen(service, mach_task_self(), 0, &conn);
+ *   IOConnectCallMethod(conn, 6, &{1}, 1, cdhash, len, NULL, NULL, NULL, NULL);
+ *
+ * KERN_SUCCESS from selector 6 means "this cdhash is trusted".  SWEET has no
+ * trust cache (patch 0015) and its AMFI policy already marks every binary on
+ * the root filesystem as a platform binary, so the honest answer here is yes.
+ * Other selectors succeed with zeroed output and are logged once each.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	registerService();
+	IOLog("SWEET AMFI: AppleMobileFileIntegrity service registered\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_amfi_logged;      /* selectors already logged (< 64) */
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector == 6) {
+		/* "is this cdhash in the trust cache?": success means yes. */
+		return kIOReturnSuccess;
+	}
+	if (selector >= 64 || !(sweet_amfi_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_amfi_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AMFI: %s sel %u in %u/%u out %u/%u -> ok (no trust cache)\n",
+		    name, selector, args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
