diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index a763588..1ffb8c9 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -835,7 +835,12 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, su.first_block + su.nblocks - SWEET_LOG_BLOCKS);
 	for (;;) {
-		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		/*
+		 * SWEET: five times a second rather than once.  Every boot that ends
