+/*
+ * SWEET: a pointer the buttons can move, for a port whose touch controller does
+ * not answer yet.  Volume up moves it right (wrapping to the left edge), volume
+ * down moves it down (wrapping to the top), and a press of the power button taps
+ * where it is: the same sweet_hid_touch() path a real touch report takes, so what
+ * iOS sees is an ordinary finger.  The cursor lives in panel pixels (1080x2340),
+ * the space the touch driver's reports use, and the framebuffer draws it there.
+ */
+#define SWEET_POINTER_MAX_X     1079
+#define SWEET_POINTER_MAX_Y     2399
+#define SWEET_POINTER_STEP      48
+#define SWEET_POINTER_TAP_US    40000
+
+static int sweet_pointer_x = SWEET_POINTER_MAX_X / 2;
+static int sweet_pointer_y = SWEET_POINTER_MAX_Y / 2;
+
+/* Where the cursor is, in panel pixels; called by the framebuffer to draw it. */
+void
+sweet_pointer_position(int *x, int *y)
+{
+	if (x != NULL) {
+		*x = sweet_pointer_x;
+	}
+	if (y != NULL) {
+		*y = sweet_pointer_y;
+	}
+}
+
+/* A button changed state; act on the press, ignore the release. */
+void
+sweet_pointer_key(int key, int down)
+{
+	if (!down) {
+		return;
+	}
+	switch (key) {
+	case 1:                         /* volume up: right, wrapping */
+		sweet_pointer_x += SWEET_POINTER_STEP;
+		if (sweet_pointer_x > SWEET_POINTER_MAX_X) {
+			sweet_pointer_x = 0;
+		}
+		break;
+	case 2:                         /* volume down: down, wrapping */
+		sweet_pointer_y += SWEET_POINTER_STEP;
+		if (sweet_pointer_y > SWEET_POINTER_MAX_Y) {
+			sweet_pointer_y = 0;
+		}
+		break;
+	case 0:                         /* power: a tap here */
+		sweet_hid_touch(0, 1, sweet_pointer_x, sweet_pointer_y);
+		delay(SWEET_POINTER_TAP_US);
+		sweet_hid_touch(0, 0, sweet_pointer_x, sweet_pointer_y);
+		break;
+	default:
+		break;
+	}
+	printf("SWEET POINTER: key %d, now %d,%d\n", key, sweet_pointer_x, sweet_pointer_y);
+}
+
 void
 sweet_keys_init(void)
 {
