+	 */
+	int want_vote = 0;
+	int power_error = 0;
+
+	if (PE_parse_boot_argn("sweetouch_vote", &want_vote, sizeof(want_vote)) && want_vote != 0) {
+		printf("SWEET TOUCH: voting L11C through RPMh (asked)\n");
+		power_error = sweet_rpmh_vreg_enable("ldoc11", 3200);
+	} else {
+		printf("SWEET TOUCH: RPMh vote skipped (sweetouch_vote=1 asks for it)\n");
+	}
 	printf("SWEET TOUCH: milestone A: RPMh vote returned %d\n", power_error);
 	if (power_error) {
 		printf("SWEET TOUCH: L11C RPMh enable failed %d; probes skipped\n", power_error);
