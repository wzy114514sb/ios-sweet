 			sweet_pointer_y = SWEET_POINTER_MAX_Y;
 		}
 		break;
-	case 2:                         /* the key on PON: right, then down a row */
+	case 2:
 		sweet_pointer_x += SWEET_POINTER_STEP;
 		if (sweet_pointer_x > SWEET_POINTER_MAX_X) {
 			sweet_pointer_x = 0;
@@ -186,11 +246,6 @@ sweet_pointer_key(int key, int down)
 			}
 		}
 		break;
-	case 0:                         /* power: a tap here */
-		sweet_hid_touch(0, 1, sweet_pointer_x, sweet_pointer_y);
-		delay(SWEET_POINTER_TAP_US);
-		sweet_hid_touch(0, 0, sweet_pointer_x, sweet_pointer_y);
-		break;
 	default:
 		break;
