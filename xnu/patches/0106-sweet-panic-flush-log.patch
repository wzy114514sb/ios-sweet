diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index a333988..a763588 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -766,53 +766,77 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
-static void
-sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+/* What the last flush wrote, and how many have happened. */
+static uint64_t sweet_log_flushed;
+static uint64_t sweet_log_seq;
+
+/*
+ * Copy whatever the ring has gained into the log area.  Called by the thread
+ * about once a second, and from the panic path just before the machine halts -
+ * a panic's own lines are the ones worth having, and the thread never runs
+ * again after it.  The lock is tried, not taken: in a panic another CPU may be
+ * holding it, and waiting there would leave the log unwritten anyway.
+ */
+void
+sweet_log_flush_once(void)
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
-	uint64_t flushed = 0, seq = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t total;
+	uint64_t pos;
+	int error = 0;
 
+	if (su.dma == 0 || su.nblocks < SWEET_LOG_BLOCKS) {
+		return;                 /* the partition is not known yet */
+	}
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total == sweet_log_flushed) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;                 /* in use; the next call gets it */
+	}
+	pos = total - sweet_log_flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : sweet_log_flushed;
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++sweet_log_seq,
+		};
+
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("SWEET LOG: write failed (%d)\n", error);
+		return;
+	}
+	sweet_log_flushed = total;
+}
+
+void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
-	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, su.first_block + su.nblocks - SWEET_LOG_BLOCKS);
 	for (;;) {
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
-		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
-		if (total == flushed) {
-			continue;
-		}
-		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
-		int error = 0;
-
-		lck_mtx_lock(&sweet_ufs_lock);
-		while (pos < total && !error) {
-			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
-			uint32_t blk = off / UFS_BLOCK;
-			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
-			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
-			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
-			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
-			error = ufs_write_blocks(base + 1 + blk, n);
-			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
-		}
-		if (!error) {
-			struct sweet_log_header h = {
-				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
-				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
-			};
-			bzero(bounce, UFS_BLOCK);
-			memcpy(bounce, &h, sizeof(h));
-			error = ufs_write_blocks(base, 1);
-		}
-		if (!error) {
-			error = ufs_sync_cache();
-		}
-		lck_mtx_unlock(&sweet_ufs_lock);
-		if (error) {
-			printf("SWEET LOG: write failed (%d), stopping\n", error);
-			return;
-		}
-		flushed = total;
+		sweet_log_flush_once();
 	}
 }
 
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 437adb1..757d31d 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1215,6 +1215,17 @@ panic_debugger_log(const char *string, ...)
 static void
 debugger_collect_diagnostics(unsigned int exception, unsigned int code, unsigned int subcode, void *state)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET: the console ring (sweetlog, bsd/dev/sweet_ufs.c) is what is read
+	 * back from recovery, and the thread that writes it out never runs again
+	 * once the machine halts.  Push the panic's own lines out now, while the
+	 * controller can still be used.
+	 */
+	extern void sweet_log_flush_once(void);
+	sweet_log_flush_once();
+#endif
+
 #if DEVELOPMENT || DEBUG
 	INJECT_NESTED_PANIC_IF_REQUESTED(PANIC_TEST_CASE_RECURPANIC_PRELOG);
 #endif
