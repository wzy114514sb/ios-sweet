+/*
+ * SWEET: log the device-tree nodes IOKit published and, for /product, the
+ * property names it carries.  MobileGestalt builds its device answers from
+ * that node; CoreUI reports "couldn't get kMGArtworkDisplayGamut" when the
+ * lookup fails, which then breaks the P3-thinned UIKit asset catalogs.
+ */
+static void
+sweet_dt_dump(void)
+{
+	IORegistryEntry *root = IORegistryEntry::fromPath("/", gIODTPlane);
+	if (root == NULL) {
+		IOLog("SWEET DT: no root\n");
+		return;
+	}
+
+	OSIterator *it = root->getChildIterator(gIODTPlane);
+	if (it != NULL) {
+		int n = 0;
+		OSObject *o;
+		while (n < 40 && (o = it->getNextObject()) != NULL) {
+			IORegistryEntry *e = OSDynamicCast(IORegistryEntry, o);
+			if (e != NULL) {
+				IOLog("SWEET DT: node %s\n", e->getName());
+				n++;
+			}
+		}
+		it->release();
+	}
+
+	IORegistryEntry *prod = root->childFromPath("product", gIODTPlane);
+	if (prod == NULL) {
+		IOLog("SWEET DT: /product missing\n");
+		root->release();
+		return;
+	}
+	OSDictionary *props = prod->getPropertyTable();
+	if (props == NULL) {
+		IOLog("SWEET DT: /product has no properties\n");
+	} else {
+		IOLog("SWEET DT: /product has %u properties\n", props->getCount());
+		OSArray *keys = props->copyKeys();
+		if (keys != NULL) {
+			for (unsigned int i = 0; i < keys->getCount() && i < 80; i++) {
+				OSSymbol *sym = OSDynamicCast(OSSymbol, keys->getObject(i));
+				if (sym != NULL) {
+					IOLog("SWEET DT: /product key %s\n", sym->getCStringNoCopy());
+				}
+			}
+			keys->release();
+		}
+	}
+	prod->release();
+	root->release();
+}
