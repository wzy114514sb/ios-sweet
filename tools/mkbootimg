#!/usr/bin/env python3
"""Minimal AOSP-compatible `mkbootimg` (boot image header v0..v2).

The VM has no AOSP/apt/pip `mkbootimg` available, so this reproduces the
subset of the CLI that ios-sweet's shim/build.sh uses:

    mkbootimg --header_version 2 --kernel Image --ramdisk rd.bin \\
        --dtb dtb.bin --base 0 --kernel_offset 0x8000 \\
        --ramdisk_offset 0x1000000 --tags_offset 0x100 \\
        --dtb_offset 0x1f00000 --pagesize 4096 --os_version 17.0.0 \\
        --os_patch_level 2035-06 --cmdline "console=null" -o boot.img

Layout (v2): header | kernel | ramdisk | second | recovery_dtbo | dtb,
every section padded to page_size. Verified by tools/bootimg-inspect.py.
"""
import argparse
import struct
import sys

MAGIC = b"ANDROID!"
HEADER_V1 = 1648
HEADER_V2 = 1660


def os_version(value):
    parts = [int(x) for x in value.replace("-", ".").split(".")]
    while len(parts) < 3:
        parts.append(0)
    a, b, c = parts[:3]
    return ((a & 0x7F) << 14) | ((b & 0x7F) << 7) | (c & 0x7F)


def os_patch_level(value):
    year, month = [int(x) for x in value.split("-")[:2]]
    return ((year - 2000) & 0x7F) << 4 | (month & 0xF)


def version_field(a, b):
    """AOSP packs the version in bits 31..11 and the patch level in 10..0.

    Checked against the stock perseus image: Android 10 / 2020-12 encodes as
    0x1400014C, which this reproduces exactly.
    """
    return ((os_version(a) if a else 0) << 11) | (os_patch_level(b) if b else 0)


def pad(data, page):
    return data + b"\0" * (-len(data) % page)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--header_version", type=int, default=0)
    p.add_argument("--kernel", required=True)
    p.add_argument("--ramdisk")
    p.add_argument("--second")
    p.add_argument("--dtb")
    p.add_argument("--base", type=lambda v: int(v, 0), default=0)
    p.add_argument("--kernel_offset", type=lambda v: int(v, 0), default=0x00008000)
    p.add_argument("--ramdisk_offset", type=lambda v: int(v, 0), default=0x01000000)
    p.add_argument("--second_offset", type=lambda v: int(v, 0), default=0x00f00000)
    p.add_argument("--tags_offset", type=lambda v: int(v, 0), default=0x00000100)
    p.add_argument("--dtb_offset", type=lambda v: int(v, 0), default=0x01f00000)
    p.add_argument("--pagesize", type=int, default=2048)
    p.add_argument("--os_version")
    p.add_argument("--os_patch_level")
    p.add_argument("--cmdline", default="")
    p.add_argument("--board", "--name", dest="name", default="")
    p.add_argument("-o", "--output", required=True)
    a = p.parse_args()

    if a.header_version > 2:
        raise SystemExit(f"header v{a.header_version} not supported by this packer")

    read = lambda path: open(path, "rb").read() if path else b""
    kernel, ramdisk, second, dtb = read(a.kernel), read(a.ramdisk), read(a.second), read(a.dtb)

    version = a.header_version
    size = HEADER_V2 if version == 2 else HEADER_V1 if version == 1 else 1608
    header = bytearray(size)
    struct.pack_into("<8s", header, 0, MAGIC)
    struct.pack_into("<10I", header, 8,
                     len(kernel), (a.base + a.kernel_offset) & 0xFFFFFFFF,
                     len(ramdisk), (a.base + a.ramdisk_offset) & 0xFFFFFFFF,
                     len(second), (a.base + a.second_offset) & 0xFFFFFFFF,
                     (a.base + a.tags_offset) & 0xFFFFFFFF, a.pagesize,
                     version,
                     version_field(a.os_version, a.os_patch_level))
    header[48:64] = a.name.encode()[:15].ljust(16, b"\0")
    header[64:576] = a.cmdline.encode()[:511].ljust(512, b"\0")
    if version >= 1:
        struct.pack_into("<I", header, 1632, 0)          # recovery_dtbo_size
        struct.pack_into("<Q", header, 1636, 0)          # recovery_dtbo_offset
        # header_size covers the whole header: 1648 for v1, 1660 for v2
        struct.pack_into("<I", header, 1644, HEADER_V2 if version >= 2 else HEADER_V1)
    if version >= 2:
        struct.pack_into("<I", header, 1648, len(dtb))
        struct.pack_into("<Q", header, 1652, (a.base + a.dtb_offset) & 0xFFFFFFFFFFFFFFFF)

    out = bytearray(pad(bytes(header), a.pagesize))
    for blob in (kernel, ramdisk, second, dtb):
        if blob:
            out += pad(blob, a.pagesize)
    with open(a.output, "wb") as fh:
        fh.write(out)
    print(f"{a.output}: {len(out)} bytes  v{version}  page={a.pagesize} "
          f"kernel={len(kernel)} ramdisk={len(ramdisk)} dtb={len(dtb)}", file=sys.stderr)


if __name__ == "__main__":
    main()
